# PostgreSQL initialization settings for a new Compose volume.
# POSTGRES_DB=reconcilio
# POSTGRES_USER=reconcilio
# POSTGRES_PASSWORD=reconcilio
# Set a connection string to give the Compose API and migration an explicit database.
# DATABASE_URL=

# Set a secret of at least 32 bytes to keep sessions valid across API restarts.
# JWT_SECRET=

# RECONCILIO_API_ENABLED=true
# RECONCILIO_WORKER_ENABLED=true
# RECONCILIO_TRACE_STDOUT=false
# RECONCILIO_METRIC_STDOUT=false

# Set both key and model to enable AI ranking.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_RESPONSES_URL=
# RECONCILIO_AI_PER_JOB_LIMIT=5
# RECONCILIO_AI_DAILY_LIMIT=50
